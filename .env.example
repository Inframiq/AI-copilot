# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:password@db.supabase.co:5432/postgres

# AI (OpenAI is the only provider)
OPENAI_API_KEY=
OPENAI_MODEL_FAST=gpt-4o-mini
OPENAI_MODEL_PREMIUM=gpt-4.1-mini

# Comma-separated extra allowed CORS origins (localhost and *.vercel.app are
# always allowed; production custom domains go here)
CORS_EXTRA_ORIGINS=

# Frontend Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8000
