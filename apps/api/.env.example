SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
DATABASE_URL=postgresql+asyncpg://postgres:password@db.supabase.co:5432/postgres
AI_PROVIDER=gemini
AI_MODEL_FAST=gemini-2.5-flash
AI_MODEL_PRO=gemini-2.5-pro
GEMINI_API_KEY=
OPENAI_API_KEY=
# Only used when AI_PROVIDER=openai. Must be REAL OpenAI model ids for your
# account. fast_model serves "fast" AND "pro" tier calls (a deliberate cost
# decision — see docs/ai-pipeline.md); premium_model serves only the two
# highest-leverage calls, which request model_tier="premium" (tailoring.py's
# Agent 2 = JD↔resume semantic mapping, Agent 3 = fact-locked bullet rewrite).
# Recommended low-cost pairing: fast=gpt-4o-mini, premium=gpt-4.1-mini.
OPENAI_MODEL_FAST=gpt-4o-mini
OPENAI_MODEL_PREMIUM=gpt-4.1-mini
# Fallback ceiling only — every call site now passes its own tighter
# max_output_tokens (see tailoring.py's _MAX_TOKENS_* constants and
# docs/ai-pipeline.md), so this value is only used if a call omits its
# override. Keep it at 16384: structured calls need real headroom or the
# model's JSON gets cut off mid-string and fails to parse. 4096 was
# confirmed too low in production; 16384 matches GeminiProvider's
# proven-safe cap for the same calls.
OPENAI_MAX_OUTPUT_TOKENS=16384

# Rolling-30-day cap on POST /ai/tailor per user (the most expensive action
# in the app — this is the cost guardrail behind a paid plan). 0 = unlimited.
TAILOR_MONTHLY_LIMIT=0
