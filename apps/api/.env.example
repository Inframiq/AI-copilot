SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
DATABASE_URL=postgresql+asyncpg://postgres:password@db.supabase.co:5432/postgres
AI_PROVIDER=gemini
AI_MODEL_FAST=gemini-2.5-flash
AI_MODEL_PRO=gemini-2.5-pro
GEMINI_API_KEY=
OPENAI_API_KEY=
# Only used when AI_PROVIDER=openai. Model is fixed to the gpt-5.6-luna
# budget tier in code — this only caps response length. Structured calls
# (e.g. generating a list of prep questions) need real headroom — too low
# and the model's JSON gets cut off mid-string and fails to parse.
OPENAI_MAX_OUTPUT_TOKENS=4096
